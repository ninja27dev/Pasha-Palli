# ==============================================================================
# Pasha Palli — Git Attributes
# Enforces consistent line endings and binary handling
# ==============================================================================

# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Code and markup
*.html text eol=lf diff=html
*.css text eol=lf diff=css
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.xml text eol=lf
*.kt text eol=lf
*.svg text eol=lf

# Binary media files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.mp3 binary
*.wav binary
*.ogg binary
*.ttf binary
*.woff binary
*.woff2 binary
