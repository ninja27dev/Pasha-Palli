# ==============================================================================
# Pasha Palli — Git Ignore Rules
# ==============================================================================

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# IDE & Editor Settings
.idea/
.vscode/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# Node / Package Manager Files
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm/

# Android Build Artifacts & Gradle
.gradle/
build/
app/build/
captures/
*.apk
*.aab
*.ap_
*.dex
local.properties
.cxx/
*.keystore
!debug.keystore

# Python & Temporary Files
__pycache__/
*.py[cod]
*$py.class
*.tmp
*.bak
*.log

# Environment & Secrets
.env
.env.local
.env.*.local
